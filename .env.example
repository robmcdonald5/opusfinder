# Neon Postgres connection string.
# Neon console -> your project -> Connection Details -> connection string.
#
# Use the DIRECT (non-pooled) connection string here. Neon also offers a
# "-pooler" host; the pooled string can error during migrations, so prefer
# the direct host. The neon-http driver works with either.
#
# Put the real value in packages/db/.env (gitignored), not in this file.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
