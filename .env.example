# Neon Postgres connection string.
# Neon console -> your project -> Connection Details -> connection string.
#
# Use the DIRECT (non-pooled) connection string here. Neon also offers a
# "-pooler" host; the pooled string can error during migrations, so prefer
# the direct host. The neon-http driver works with either.
#
# Put the real value in packages/db/.env (gitignored), not in this file.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Anthropic API key for the LLM package (packages/llm).
# Anthropic Console -> Settings -> API Keys. The key starts with "sk-ant-".
#
# Put the real value in packages/llm/.env (gitignored), not in this file.
# A pre-set ANTHROPIC_API_KEY environment variable also works.
ANTHROPIC_API_KEY=

# Voyage AI API key for the embeddings package (packages/embeddings).
# Voyage dashboard -> API Keys (https://dashboard.voyageai.com). The key starts with
# "pa-". The free tier (first 200M tokens) covers development comfortably.
#
# Put the real value in packages/embeddings/.env (gitignored), not in this file.
# A pre-set VOYAGE_API_KEY environment variable also works.
VOYAGE_API_KEY=

# Better Auth signing secret for the auth package (packages/auth) — Phase 9.5 user identity.
# Generate a strong random value:
#   openssl rand -base64 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
#
# Put the real value in packages/auth/.env (gitignored). NEVER commit a real secret here.
BETTER_AUTH_SECRET=

# Better Auth base URL (packages/auth). Pre-UI a localhost placeholder is fine; it becomes
# load-bearing only when the Phase-12 SvelteKit auth handler mounts. Defaults to
# http://localhost:5173 if unset. Put any real value in packages/auth/.env (gitignored).
BETTER_AUTH_URL=

# --- Inngest digest runtime (packages/inngest) — Phase 10 is LOCAL-DEV-ONLY -----------------------
# Phase 10 runs the digest pipeline against the local Inngest dev server, which needs NO account and
# NO keys. The three vars below are all you touch locally, and only INNGEST_DEV matters:
#
#   1. Terminal A:  pnpm inngest:dev      # the local dev server (npx inngest-cli — no account/keys)
#   2. Terminal B:  $env:INNGEST_DEV=1; pnpm inngest:serve   # the serve endpoint on :3000
#   3. Terminal C:  $env:INNGEST_DEV=1; pnpm digest --user <uuid>   # (or --all) fire + poll
#
# With INNGEST_DEV=1 the SDK routes events to localhost and skips signature verification. The digest
# itself still needs DATABASE_URL + ANTHROPIC_API_KEY (the per-user fn does the Haiku rerank + the
# Sonnet synthesis batch) — those live in packages/db/.env + packages/llm/.env as before.
#
# INNGEST_DEV: set to 1 for local dev. Leave UNSET in production (then the SDK verifies signatures).
INNGEST_DEV=

# INNGEST_SIGNING_KEY / INNGEST_EVENT_KEY: NOT needed for Phase 10 (local dev). They become required
# only for a Phase-12 PRODUCTION serve on Inngest Cloud (signed event ingestion + request
# verification). The Inngest SDK reads BOTH straight from the process environment — there is no repo
# loader for them; when Phase 12 lands, set the REAL values on the hosting platform — NEVER commit them.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
