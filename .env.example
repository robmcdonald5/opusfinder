# Neon Postgres connection string.
# Neon console -> your project -> Connection Details -> connection string.
#
# Use the DIRECT (non-pooled) connection string here. Neon also offers a
# "-pooler" host; the pooled string can error during migrations, so prefer
# the direct host. The neon-http driver works with either.
#
# Put the real value in packages/db/.env (gitignored), not in this file.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Anthropic API key for the LLM package (packages/llm).
# Anthropic Console -> Settings -> API Keys. The key starts with "sk-ant-".
#
# Put the real value in packages/llm/.env (gitignored), not in this file.
# A pre-set ANTHROPIC_API_KEY environment variable also works.
ANTHROPIC_API_KEY=

# Voyage AI API key for the embeddings package (packages/embeddings).
# Voyage dashboard -> API Keys (https://dashboard.voyageai.com). The key starts with "pa-".
# `voyage-3-large` has NO free tier — it bills $0.18 / 1M tokens from the first token (there is no
# in-code 429 backoff), so a card on file is required. The Phase-F8 `embed-backlog-drain` (the deployed
# runtime's nightly cron) also consumes this key, not just the local backfill.
#
# Put the real value in packages/embeddings/.env (gitignored), not in this file.
# A pre-set VOYAGE_API_KEY environment variable also works.
VOYAGE_API_KEY=

# Better Auth signing secret for the auth package (packages/auth) — Phase 9.5 user identity.
# Generate a strong random value:
#   openssl rand -base64 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
#
# Put the real value in packages/auth/.env (gitignored). NEVER commit a real secret here.
BETTER_AUTH_SECRET=

# Better Auth base URL (packages/auth). Pre-UI a localhost placeholder is fine; it becomes
# load-bearing only when the Phase-12 SvelteKit auth handler mounts. Defaults to
# http://localhost:5173 if unset. Put any real value in packages/auth/.env (gitignored).
BETTER_AUTH_URL=

# --- Inngest digest runtime (packages/inngest) — Phase 10 is LOCAL-DEV-ONLY -----------------------
# Phase 10 runs the digest pipeline against the local Inngest dev server, which needs NO account and
# NO keys. The three vars below are all you touch locally, and only INNGEST_DEV matters:
#
#   1. Terminal A:  pnpm inngest:dev      # the local dev server (npx inngest-cli — no account/keys)
#   2. Terminal B:  $env:INNGEST_DEV=1; pnpm inngest:serve   # the serve endpoint on :3000
#   3. Terminal C:  $env:INNGEST_DEV=1; pnpm digest --user <uuid>   # (or --all) fire + poll
#
# With INNGEST_DEV=1 the SDK routes events to localhost and skips signature verification. The digest
# itself still needs DATABASE_URL + ANTHROPIC_API_KEY (the per-user fn does the Haiku rerank + the
# Sonnet synthesis batch) — those live in packages/db/.env + packages/llm/.env as before.
#
# INNGEST_DEV: set to 1 for local dev. Leave UNSET in production — on the deployed (Phase-12a) runtime
# its mere PRESENCE puts the SDK in dev mode, so the Cloud serve endpoint answers 503. Unset = the SDK
# verifies signatures (the production path).
INNGEST_DEV=

# INNGEST_SIGNING_KEY / INNGEST_EVENT_KEY: NOT needed for local dev. In PRODUCTION (Phase-12a serve on
# Inngest Cloud) the Inngest↔Vercel integration AUTO-PROVISIONS both on the Vercel project — do NOT set
# them by hand (and never commit them). The Inngest SDK reads them straight from the process environment;
# there is no repo loader for them.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Resend email delivery (packages/email) — Phase 11 -------------------------------------------
# The digest send runs from the serve process (local dev, or the Phase-12a deployed runtime + cadence
# cron). Delivery webhooks / unsubscribe remain Phase 12b. All vars live in packages/email/.env
# (gitignored), never in this file.
#
# RESEND_API_KEY: the SEND key (POST /emails) — a "sending access"-only key is enough (and is the
# least-privilege choice). Resend dashboard -> API Keys (https://resend.com/api-keys). Starts "re_".
RESEND_API_KEY=

# RESEND_API_KEY_FULL: the READ key for the post-send delivery poll (GET /emails/:id) — MUST be a
# full-access key (a sending-only key 401s with restricted_api_key on reads; observed at the Phase-11
# gate). Single-key setups put the same full-access value in both vars. Retires with Phase-12 webhooks.
RESEND_API_KEY_FULL=

# EMAIL_FROM: the verified sender, display-name form. The sending domain must be verified on Resend
# (SPF/DKIM/DMARC records at the opusfinder.ai DNS host; Phase-11 default: send.opusfinder.ai).
# Example: EMAIL_FROM=opusfinder digest <digest@send.opusfinder.ai>
EMAIL_FROM=

# EMAIL_ALLOWLIST: comma-separated addresses allowed to receive REAL email. FAIL-CLOSED: unset =>
# every send refuses (throws); an unlisted recipient => a recorded skip (digests.delivery_status
# stays 'none'). This is the safety net that keeps an `--all` sweep from emailing eval-profile users;
# removed with the Phase-12 signup flow. Put the owner's address here.
EMAIL_ALLOWLIST=

# --- Phase F6 pipeline health & alerting (`pnpm health`, the Worker heartbeat) ---------------------
# ALERT_TO: the operator address health alerts (`sendHealthAlert`) are sent to. DEDICATED — keep it
# DISTINCT from EMAIL_ALLOWLIST (the owner is an operator here, not a product user; coupling the alert
# to the fail-closed digest allowlist risks the alert itself being the silently-broken thing). FAIL-LOUD:
# if `pnpm health` needs to alert and this is unset, it throws + exits non-zero, never silently no-ops.
# Lives in packages/email/.env (alongside RESEND_API_KEY / EMAIL_FROM, which the alert send also needs).
ALERT_TO=

# --- Phase F2 lifecycle-close enforcement (the single switch across Arms A/B/C) ---------------------
# F2_ENFORCE: "shadow" (default — count-only: keep the absence streak + tally `wouldClose`, write no
# 'closed') or "enforce" (flip the 'closed' write on). ONE flag governs all three F2 arms — the Worker
# reads it (apps/scrapers/wrangler.toml [vars]) for the per-board sweep (Arm A) + board-death close (Arm B),
# and the digest runtime reads THIS env value (process.env.F2_ENFORCE) for the 410-close (Arm C). Set BOTH
# to "enforce" together, only after reviewing the shadow counters. Unset / anything but enforce = shadow.
F2_ENFORCE=

# HEALTH_ENFORCE: comma-separated check ids that PAGE (set report unhealthy → `pnpm health` emails
# ALERT_TO + exits 1). Everything else stays SHADOW (computed + printed, but never paged). Ship shadow,
# validate the thresholds on live traffic for days, THEN add a check here. UNTIL you set this, `pnpm
# health` only PRINTS — it never alerts. Valid ids: ingestion_staleness, board_fail_ratio,
# discovery_window, embedding_backlog, digest_health, bounce_suppression, discovery_lane_errors.
# (HEALTH_OFF, same format, fully disables a check.) Lives in packages/db/.env.
HEALTH_ENFORCE=

# HEALTH_* thresholds (all OPTIONAL — sensible defaults bake in; negatives are rejected). Override in
# packages/db/.env only to retune: HEALTH_INGEST_MAX_AGE_H (default 3, ~3× the hourly cron so one missed
# tick doesn't flap), HEALTH_FAIL_RATIO (0.5), HEALTH_DISCOVERY_MAX_AGE_D (13), HEALTH_BACKLOG_MAX (2000),
# HEALTH_DIGEST_WINDOW_N (10), HEALTH_COST_ROLLUP_N (20). The two window
# sizes (DIGEST_WINDOW_N / COST_ROLLUP_N) are clamped to >=1 — a 0 would disarm the check it sizes.

# HEALTH_PING_URL: the external-watchdog ping URL for the Worker's liveness heartbeat — a dead-man's
# switch (e.g. a free healthchecks.io check) that emails you when the cron STOPS pinging. This is a
# WORKER SECRET, NOT a .env var: set it with `wrangler secret put HEALTH_PING_URL` in apps/scrapers.
# Optional — unset => the heartbeat is skipped silently.

# HEALTH_PING_TOKEN: gates the full /api/health detailed body. Pass it as `Authorization: Bearer <token>`
# OR `?token=<token>`; a matching request gets the full check breakdown, everyone else gets only the
# minimal { unhealthy } body (the 200/503 uptime status stays public either way). UNSET = secure-default:
# the detailed body is served to NO ONE. Distinct from HEALTH_PING_URL (a Worker secret) — this is a
# Vercel/Node env var read via process.env by the apps/web SvelteKit serve route (the /api/health handler).
HEALTH_PING_TOKEN=
