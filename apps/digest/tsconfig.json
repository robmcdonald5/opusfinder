{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Workers runtime types ONLY — no @types/node. This is the authoritative Worker-safety type check for
    // this Worker AND for everything it compiles through its import graph (@opusfinder/digest, db, llm,
    // email, rerank, locations): a Node-only global or a node:* import anywhere in that graph fails here,
    // including a type-only one a bundle scan can't see. Uses the @cloudflare/workers-types package (which
    // also declares `cloudflare:workers` and `cloudflare:workflows`), like apps/control.
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"],
    "noEmit": true
  },
  // Shippable Worker surface. The *.test.ts suites beside it are NODE-side (PGlite, Miniflare, esbuild) —
  // type-checked by the root tsconfig.test.json under node types instead. The only src they import is
  // runtime-neutral (steps.ts, fan-out.ts, control.ts: no Workers or Node globals).
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", ".wrangler", "dist", "src/**/*.test.ts"]
}
