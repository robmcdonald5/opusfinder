{
  "name": "opusfinder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:scrapers": "pnpm --filter @opusfinder/scrapers typecheck",
    "guard:worker": "node scripts/check-worker-isolation.mjs",
    "db:migrate": "pnpm --filter @opusfinder/db migrate",
    "db:backfill-signatures": "pnpm --filter @opusfinder/db backfill-signatures",
    "db:ping": "pnpm --filter @opusfinder/db ping",
    "runs": "pnpm --filter @opusfinder/db runs",
    "ingest": "pnpm --filter @opusfinder/sources ingest",
    "ingest:all": "pnpm --filter @opusfinder/sources ingest:all",
    "discover": "pnpm --filter @opusfinder/discovery discover",
    "llm:test": "pnpm --filter @opusfinder/llm test:llm",
    "embeddings:backfill": "pnpm --filter @opusfinder/embeddings backfill",
    "embeddings:search": "pnpm --filter @opusfinder/embeddings run search",
    "eval": "pnpm --filter @opusfinder/eval run eval",
    "eval:compare": "pnpm --filter @opusfinder/eval run eval:compare",
    "ingest-cv": "pnpm --filter @opusfinder/profiles ingest-cv",
    "profiles:restructure": "pnpm --filter @opusfinder/profiles profiles:restructure",
    "user:create": "pnpm --filter @opusfinder/auth user:create",
    "user:set-prefs": "pnpm --filter @opusfinder/auth user:set-prefs",
    "user:list": "pnpm --filter @opusfinder/auth user:list",
    "digest": "pnpm --filter @opusfinder/inngest digest",
    "email:preview": "pnpm --filter @opusfinder/email preview",
    "inngest:serve": "pnpm --filter @opusfinder/inngest inngest:serve",
    "inngest:dev": "npx --yes inngest-cli@latest dev -u http://localhost:3000/api/inngest --no-discovery"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "eslint": "^10",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8"
  }
}
