{
  "name": "opusfinder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "pnpm --filter @opusfinder/db migrate",
    "db:ping": "pnpm --filter @opusfinder/db ping",
    "fetch:greenhouse": "pnpm --filter @opusfinder/sources fetch:greenhouse"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "eslint": "^10",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8"
  }
}
